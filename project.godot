; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="卡牌大冒险"
config/description="2.5D Q版策略卡牌放置 RPG · 卡牌收集养成 + 阵型位面战术"
run/main_scene="res://scenes/main_menu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

GameDB="*res://scripts/game_db.gd"
SaveDB="*res://scripts/save_db.gd"
RealmDB="*res://scripts/realm_db.gd"
StaminaSys="*res://scripts/stamina.gd"
BattleCtx="*res://scripts/battle_ctx.gd"
GachaSys="*res://scripts/gacha_sys.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]

theme/custom_font="res://assets/fonts/ui_font.tres"

[importer_defaults]

svg={
"svg/scale": 3.0
}
texture={
"mipmaps/generate": true
}

[physics]

3d/physics_engine="Jolt Physics"
